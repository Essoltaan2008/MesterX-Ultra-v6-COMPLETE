# ── Database ───────────────────────────────────────────────────────────────────
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_NAME=${DB_NAME}
DATABASE_URL=${DATABASE_URL}

# ── Redis (if used) ────────────────────────────────────────────────────────────
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT}
REDIS_PASSWORD=${REDIS_PASSWORD}

# ── Application runtime ────────────────────────────────────────────────────────
NODE_ENV=production
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5000

# ── Security / JWT ─────────────────────────────────────────────────────────────
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRY_MINUTES=${JWT_EXPIRY_MINUTES}
JWT_REFRESH_DAYS=${JWT_REFRESH_DAYS}

# ── Business settings ──────────────────────────────────────────────────────────
CURRENCY=${CURRENCY}
CURRENCY_SYMBOL=${CURRENCY_SYMBOL}
VAT_RATE=${VAT_RATE}

# ── Pricing tiers ──────────────────────────────────────────────────────────────
PRICE_BASIC=${PRICE_BASIC}
PRICE_PRO_MONTHLY=${PRICE_PRO_MONTHLY}
PRICE_ENTERPRISE=${PRICE_ENTERPRISE}
PRICE_LIFETIME=${PRICE_LIFETIME}
PRICE_SYNC_ADDON=${PRICE_SYNC_ADDON}

# ── Admin ──────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=${ADMIN_EMAIL}
MFA_REQUIRED_FOR_ADMIN=${MFA_REQUIRED_FOR_ADMIN}
MFA_ISSUER=${MFA_ISSUER}

# ── S3 / Object storage ────────────────────────────────────────────────────────
S3_BUCKET=${S3_BUCKET}
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}

# ── Licensing & encryption ─────────────────────────────────────────────────────
LICENSE_SIGNING_KEY=${LICENSE_SIGNING_KEY}
BACKUP_ENCRYPTION_KEY=${BACKUP_ENCRYPTION_KEY}

# ── URLs ───────────────────────────────────────────────────────────────────────
DOMAIN=${DOMAIN}
FRONTEND_URL=${FRONTEND_URL}
API_URL=${API_URL}

# ── Trial ──────────────────────────────────────────────────────────────────────
TRIAL_DAYS=${TRIAL_DAYS}
